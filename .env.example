# Backend (Railway -> service -> Variables)
DATABASE_URL=            # reference to the Postgres service; empty = local SQLite
SECRET_KEY=              # long random string, keeps admin sessions valid across restarts
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=          # used once to create the admin user (change it in Admin > Account)
SITE_URL=https://zimbermanne.com
CORS_ORIGINS=http://localhost:5173
RESEND_API_KEY=          # optional: email inquiries + welcome emails
CONTACT_TO=hello@zimbermanne.com
CONTACT_FROM=
WHATSAPP_NUMBER=         # e.g. 255700000000
VIEW_MULTIPLIER=1
