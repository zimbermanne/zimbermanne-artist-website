+/* ---------- player: desktop bar + phone mini bar / full-screen player ---------- */
+.player-now-playing { background: none; border: 0; padding: 0; color: inherit; font: inherit; text-align: left; cursor: default; -webkit-tap-highlight-color: transparent; }
+.player-details > span { display: block; }
+.player-album-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.transport { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
+.skip-btn { width: 36px; height: 36px; border-radius: 50%; border: 0; background: transparent; color: var(--text); display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; }
+.skip-btn:hover { color: var(--gold); }
+.skip-btn svg { width: 20px; height: 20px; }
+.play-btn-large svg { width: 22px; height: 22px; }
+.player-bar .ico-pause, .player-bar.is-playing .ico-play { display: none; }
+.player-bar.is-playing .ico-pause { display: block; }
+.player-bar button, .player-bar a, .progress-bar { touch-action: manipulation; }
+.player-bar button:focus-visible, .progress-bar:focus-visible, .player-bar a:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
+.progress-bar { overflow: visible; touch-action: none; }
+.progress-bar::before { content: ""; position: absolute; left: 0; right: 0; top: -12px; bottom: -12px; }
+.mini-progress, .sheet-close { display: none; }
+.tracks li.now-playing .track-title { color: var(--gold); }
+.tracks li.now-playing { background: rgba(201, 160, 99, 0.08); }
+.player-bar #playerSunoLink { padding: 8px 14px; font-size: 11px; }
+.song-audio { width: 100%; max-width: 100%; }
+
+@media (max-width: 768px) {
+  body { padding-bottom: calc(84px + env(safe-area-inset-bottom)); }
+  body.subpage { padding-bottom: 0; }
+  .player-bar { padding: 10px 12px calc(10px + env(safe-area-inset-bottom)); gap: 8px; flex-wrap: nowrap; align-items: center; }
+  .player-now-playing { flex: 1 1 auto; min-width: 0; max-width: none; cursor: pointer; }
+  .player-cover { width: 48px; height: 48px; flex-shrink: 0; }
+  .player-details { min-width: 0; }
+  .player-controls { flex: 0 0 auto; max-width: none; gap: 0; }
+  .transport { gap: 2px; }
+  .skip-btn { width: 44px; height: 44px; }
+  .play-btn-large { width: 48px; height: 48px; }
+  .progress-bar-wrap, .player-right-actions { display: none; }
+  .mini-progress { display: block; position: absolute; left: 0; right: 0; top: 0; height: 3px; background: rgba(255,255,255,0.1); }
