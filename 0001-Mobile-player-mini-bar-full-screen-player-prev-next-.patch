+  .tracks .btn-icon { order: -1; }
+}
+@media (max-width: 768px) and (max-height: 560px) {
+  .player-bar.expanded .player-cover { width: 96px; height: 96px; }
+}
+@media (prefers-reduced-motion: reduce) { .progress-fill, .play-btn-large { transition: none; } }
